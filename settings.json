{
  "lastChangelogVersion": "1.5.2",
  "theme": "catppuccin-mocha",
  "quietStartup": "header",
  "defaultProvider": "claude-code",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "cacheWarming": "idle",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-compact-thinking",
    "https://github.com/earendil-works/pi-claude-code"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "showImages": false
  },
  "tuiMode": "fullscreen",
  "extensions": [
    "-extensions/web-search.ts",
    "-extensions/gh-grep.ts",
    "-extensions/context7.ts"
  ]
}