{
  "enabled": true,
  "allowBrowserProcess": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": false,
    "allowUnauthenticatedSocksProxy": false,
    "allowedDomains": ["*"],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "~",
      "~/.pi/agent/auth.json"
    ],
    "allowRead": [
      ".",
      "~/.local/bin",
      "~/.local/share/mise",
      "~/.nvm",
      "~/.gradle",
      "~/.m2/repository",
      "~/.npm",
      "~/.pi/agent"
    ],
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      ".git/hooks",
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.git-credentials",
      "~/.npmrc",
      "~/.netrc"
    ]
  }
}
