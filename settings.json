{
  "lastChangelogVersion": "1.4.0",
  "theme": "catppuccin-mocha",
  "quietStartup": "header",
  "defaultProvider": "kimi-coding",
  "defaultModel": "k3.1-pro",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-compact-thinking"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "showImages": false
  },
  "tuiMode": "fullscreen",
  "extensions": [
    "-extensions/web-search.ts",
    "-extensions/gh-grep.ts",
    "-extensions/context7.ts"
  ]
}