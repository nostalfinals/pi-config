{
  "lastChangelogVersion": "0.83.0",
  "theme": "catppuccin-mocha",
  "quietStartup": true,
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-compact-thinking",
    {
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "extensions": [
        "-index.ts"
      ]
    },
    "git:github.com/nostalfinals/pi-sandbox",
    "git:github.com/nostalfinals/pi-dcp",
    "git:https://github.com/nostalfinals/pi-codex-search",
    {
      "source": "npm:@upstash/context7-pi",
      "skills": [
        "-skills/context7-docs/SKILL.md"
      ]
    }
  ],
  "terminal": {
    "showTerminalProgress": true
  }
}