{
  "lastChangelogVersion": "0.85.1",
  "theme": "catppuccin-mocha",
  "quietStartup": true,
  "defaultProvider": "bigmodel",
  "defaultModel": "glm-5.3-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "packages": [
    {
      "source": "git:github.com/nostalfinals/pi-sandbox",
      "extensions": [
        "-index.ts"
      ]
    },
    "git:github.com/nostalfinals/cooperate@330b220f81620f4e14ffc2ed0ef08c9601338fcf",
    "npm:pi-compact-thinking"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "skills": [
    "-skills/auto-implement/SKILL.md",
    "-skills/create-implementation-task/SKILL.md",
    "-skills/design/SKILL.md",
    "-skills/implement/SKILL.md",
    "-skills/tdd/SKILL.md"
  ],
  "tuiMode": "fullscreen",
  "extensions": [
    "-extensions/openai-fast.ts"
  ]
}