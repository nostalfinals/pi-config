{
  "enabled": true,
  "allowBrowserProcess": true,
  "network": {
    "disabled": true
  },
  "filesystem": {
    "disableMandatoryProtections": true,
    "denyRead": [
      "~",
      "~/.pi/agent/auth.json",
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx"
    ],
    "allowRead": [
      ".",
      "~/.local/bin",
      "~/.local/share/mise",
      "~/.nvm",
      "~/.gradle",
      "~/.m2/repository",
      "~/.npm",
      "~/.pi/agent",
      "~/.gitconfig",
      "~/.config/git",
      "~/.config/gh",
      "~/.git-credentials"
    ],
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyWrite": [
      ".git/hooks",
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.git-credentials",
      "~/.npmrc",
      "~/.netrc"
    ]
  }
}
