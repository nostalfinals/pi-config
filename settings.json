  "theme": "catppuccin-mocha",
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna-fast",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": true,
  "packages": [
    {
      "source": "git:github.com/nostalfinals/pi-sandbox",
