{
  "enabled": true,
  "allowBrowserProcess": true,
  "network": {
    "disabled": true
  },
  "filesystem": {
    "disableMandatoryProtections": true,
    "denyRead": [
      "~",
      "~/.pi/agent/auth.json"
    ],
    "allowRead": [
      ".",
      "~/.local/bin",
      "~/.local/share/mise",
      "~/.nvm",
      "~/.gradle",
      "~/.m2/repository",
      "~/.npm",
      "~/.pi/agent",
      "~/.gitconfig",
      "~/.config/git",
      "~/.config/gh",
      "~/.git-credentials"
    ],
    "denyWrite": [],
    "autoAllowGitWorktree": true,
    "allowWrite": [
      ".",
      "/tmp",
      "~/.nvm",
      "~/.gradle",
      "~/.m2/repository",
      "~/.npm",
      "~/.pi/agent"
    ]
  }
}
